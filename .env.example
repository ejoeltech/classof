APP_NAME="Classof"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/classof
APP_TIMEZONE=Africa/Lagos
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=classof
DB_USERNAME=root
DB_PASSWORD=

# Payment gateway: manual | paystack | stripe
PAYMENT_GATEWAY=manual
PAYMENT_CURRENCY=NGN

# Manual / offline bank transfer details
MANUAL_BANK_NAME=Classof Alumni Account
MANUAL_BANK_ACCOUNT=0123456789
MANUAL_BANK_HOLDER=Classof Alumni Association

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MAIL_DRIVER=log
MAIL_FROM="no-reply@classof.local"

# WhatsApp Cloud API. Leave driver=log to write messages to storage/logs/whatsapp.log.
WHATSAPP_DRIVER=log
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_ANNOUNCEMENT=classof_announcement
WHATSAPP_TEMPLATE_EVENT=classof_event_reminder

# Group websites. Set SITE_DOMAIN=classof.com in production and point
# *.classof.com at this application. Leave it empty to only use /site/{subdomain}.
SITE_DOMAIN=

# Optional OpenAI-compatible endpoint for the "Draft with AI" button.
# Without a key the site editor generates a structured draft from group data.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=20
